// DealForge data model — the spine of the Living Deal Twin.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ---------------------------------------------------------------------------
// Opportunity: the root of the Living Deal Twin.
// ---------------------------------------------------------------------------
model Opportunity {
  id          String   @id @default(cuid())
  name        String
  client      String
  industry    String
  countries   String // comma-separated country names
  legalEntities String @default("")
  oracleEnvironment String @default("") // existing modules/versions summary
  dealType    String // EBS Upgrade, Fusion Implementation, Managed Services, EPM, HCM & Payroll, SOD Review, OCI Migration, APEX Modernisation
  modules     String // comma-separated selected modules, drives Discovery Architect
  budgetMin   Float?
  budgetMax   Float?
  currency    String  @default("USD")
  timelineMonths Int?
  probability Int     @default(20) // 0-100
  momentum    String  @default("Steady") // Accelerating, Steady, Stalling, At risk
  nextAction  String  @default("")
  stage       String  @default("Qualifying") // Qualifying, Discovery, Solutioning, Pricing, Proposal, Negotiation, Won, Lost
  oracleRegistrationStatus String @default("Not registered")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  dealItems         DealItem[]
  discoveryQuestions DiscoveryQuestion[]
  estimate          Estimate?
  promises          Promise[]
  proposals         Proposal[]
}

enum DealItemStatus {
  CONFIRMED_BY_CLIENT
  FOUND_IN_DOCUMENTS
  ASSUMED_BY_INTELLOGER
  INTERNALLY_PROPOSED
  STILL_UNKNOWN
  CONTRADICTORY
}

// Any discrete fact/assumption/commitment tracked on the Deal Twin.
model DealItem {
  id            String         @id @default(cuid())
  opportunityId String
  opportunity   Opportunity    @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  category      String // Company, Environment, Stakeholders, Budget, Risk, Competitor, ...
  label         String
  value         String
  status        DealItemStatus @default(STILL_UNKNOWN)
  source        String  @default("") // who said it / which document
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Discovery Architect
// ---------------------------------------------------------------------------
model DiscoveryQuestion {
  id            String      @id @default(cuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  module        String // Finance, HCM, Integrations, Data Migration, Security, Technical, Commercial
  text          String
  criticalForPricing Boolean @default(false)
  answered      Boolean     @default(false)
  answer        String      @default("")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

// ---------------------------------------------------------------------------
// Commercial Lab (estimator)
// ---------------------------------------------------------------------------
model Estimate {
  id            String      @id @default(cuid())
  opportunityId String      @unique
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  // Estimation inputs, stored as JSON so the shape can evolve freely.
  inputs        String // JSON: { entities, countries, modules, users, businessUnits, integrations, reports, dataObjects, workflows, testingCycles, trainingPopulations, onSiteShare, documentationQuality, governanceComplexity }
  multipliers   String // JSON: { key: boolean } selected complexity multipliers

  baseEffortDays Float @default(0)
  adjustedEffortDays Float @default(0)
  dayRate        Float @default(1200)
  internalCostPerDay Float @default(650)

  p50Days       Float @default(0)
  p80Days       Float @default(0)
  maxDays       Float @default(0)

  internalCost  Float @default(0)
  customerPrice Float @default(0)
  grossMargin   Float @default(0) // percentage
  contingencyPct Float @default(10)

  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Promise Ledger
// ---------------------------------------------------------------------------
enum PromiseClassification {
  CONTRACTUAL_COMMITMENT
  PROPOSED_DELIVERABLE
  ASSUMPTION
  EXCLUSION
  TARGET
  INFORMAL_DISCUSSION
  CLIENT_RESPONSIBILITY
  PENDING_CONFIRMATION
}

model Promise {
  id            String                 @id @default(cuid())
  opportunityId String
  opportunity   Opportunity            @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  statement     String
  classification PromiseClassification @default(INFORMAL_DISCUSSION)
  saidBy        String  @default("")
  source        String  @default("") // meeting, email, proposal section
  owner         String  @default("")
  inSOW         Boolean @default(false)
  commercialEffortIncluded Boolean @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Proposal Studio
// ---------------------------------------------------------------------------
enum ProposalStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SENT
}

model Proposal {
  id            String         @id @default(cuid())
  opportunityId String
  opportunity   Opportunity    @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  title         String
  docType       String // Executive Proposal, Full Proposal, SOW, Budgetary Estimate, One-Pager
  persona       String // CFO, CIO, HR Director, Procurement, CEO, Oracle
  content       String // generated markdown
  status        ProposalStatus @default(DRAFT)
  approverNote  String  @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Proof and Reference Vault
// ---------------------------------------------------------------------------
model ProofItem {
  id            String   @id @default(cuid())
  title         String
  type          String // Reference, Case Study, CV, Certification, Architecture Diagram, SOW Template
  industry      String  @default("")
  country       String  @default("")
  oracleProduct String  @default("")
  summary       String
  confidentiality String @default("Publicly usable") // Publicly usable, Name-confidential, Verbal only, Requires permission, Expired
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
