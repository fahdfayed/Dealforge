# Local development needs none of these — the defaults below are what the app
# uses when they are unset. They are listed so a deployment knows what to set.

# --- database -----------------------------------------------------------------
# libSQL. A file: URL locally, a libsql:// URL for Turso.
DATABASE_URL="file:./data/dealforge.db"
# Required for Turso, unused for a local file.
DATABASE_AUTH_TOKEN=""

# --- file storage --------------------------------------------------------------
# Uploaded resumes, source documents and proof files.
#
# Leave STORAGE_BUCKET unset locally to write under STORAGE_DIR. It must be set
# in production: a managed platform's filesystem is ephemeral, so uploads
# written to disk do not survive a deploy.
STORAGE_DIR="./.storage"
STORAGE_BUCKET=""
# R2 and most S3-compatible providers need an endpoint; AWS S3 infers it.
STORAGE_ENDPOINT=""
STORAGE_REGION="auto"
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
